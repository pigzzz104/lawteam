  "case_number_pattern": "(?:(?:(?![的在查收收到代理案号文您你请])[\\u4e00-\\u9fa5]){1,6}(?:劳人仲|仲[案裁]?字?|案字))?[（(〔\\[]\\s*\\d{4}\\s*[）)\\]〕]\\s*[\\u4e00-\\u9fa5A-Za-z0-9]{1,14}第?\\d+号",
