# ==========================================
# LawTeam-OS Environment Configuration
# ==========================================

# --- Application ---
APP_ENV=development
APP_NAME=LawTeam-OS
TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=lawteam
POSTGRES_PASSWORD=lawteam_dev_password
POSTGRES_DB=lawteam
DATABASE_URL=postgresql+psycopg://lawteam:lawteam_dev_password@localhost:5432/lawteam

# --- Security & JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Case File Bridge (NAS / Local Root) ---
CASES_ROOT=./data/cases

# --- Court Document Fetching & Auto-Archiving Policy ---
# confirm_before_sign: Stage Tier-2 links requiring sign-in confirmation before clicking official receipt
# auto_all: Automatically fetch Tier-1 & Tier-2 documents upon SMS arrival
COURT_AUTO_FETCH_MODE=confirm_before_sign
# Default auto-archive SMS docs & invoices when covered by rules and unambiguously matched to a case
AUTO_ARCHIVE_ENABLED=true
FRONTEND_BASE_URL=http://127.0.0.1:5173

# --- Enterprise WeChat & Personal WeChat Push Gateways ---
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# Keep true in local development to log/persist notifications without external HTTP push
WECOM_DRY_RUN=true
# Optional global WxPusher appToken when lawyers configure notify_channel=wxpusher with UID_xxx
WXPUSHER_APP_TOKEN=
# APScheduler reminder sweep configuration
ENABLE_REMINDER_SCHEDULER=true
REMINDER_POLL_INTERVAL_SECONDS=60

# --- Universal LLM Configuration (Optional Regex Fallback Only) ---
# Supported providers: none | openai_compatible | anthropic
# NOTE: LLM only extracts factual fields when regex fails; NEVER calculates statutory deadlines.
LLM_PROVIDER=none
# Examples:
#   openai_compatible: https://api.openai.com/v1 or https://api.deepseek.com/v1 or http://localhost:11434/v1
#   anthropic: https://api.anthropic.com
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
